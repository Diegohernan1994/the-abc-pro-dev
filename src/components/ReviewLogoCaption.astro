---
interface Props { text?: string; }
const { text = 'Trusted by Local Homeowners' } = Astro.props;
---
<p class="review-logo-caption"><span>{text}</span></p>
<style>
  .review-logo-caption { display: flex; align-items: center; gap: 14px; width: 100%; margin: 0; color: #fff; font-family: 'Lato', Arial, sans-serif; font-size: 14px; font-weight: 400; line-height: 1.45; letter-spacing: .2px; text-align: center; }
  .review-logo-caption::before, .review-logo-caption::after { content: ''; flex: 1 1 24px; min-width: 20px; height: 1px; background: rgba(186, 164, 117, .7); }
  .review-logo-caption span { flex: 0 1 auto; }
  @media (max-width: 480px) { .review-logo-caption { font-size: 13px; gap: 10px; } }
</style>
