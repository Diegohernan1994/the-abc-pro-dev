---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const landings = [
  {
    title: "Remodeling Plans & 3D Design",
    slug: base + "/landing-3d-design/",
    desc: "Move beyond inspiration with 3D design that helps you see the right direction before construction starts.",
    badge: "3D Visualizer",
    icon: "fa-solid fa-cube",
    bg: "/assets/general/plans-hero.webp"
  },
  {
    title: "Luxury Kitchen Remodeling",
    slug: base + "/landing-kitchen/",
    desc: "See the possibilities in 3D, then create a kitchen that feels as good to live in as it looks.",
    badge: "Kitchen Specialist",
    icon: "fa-solid fa-kitchen-set",
    bg: "/assets/kitchen/hero.webp"
  },
  {
    title: "Bathroom Remodeling",
    slug: base + "/landing-bathroom/",
    desc: "A clearer plan for layout, plumbing, ventilation, and premium finishes before work begins.",
    badge: "Bath Renovation",
    icon: "fa-solid fa-bath",
    bg: "/assets/bath/hero2.webp"
  },
  {
    title: "Home Additions",
    slug: base + "/landing-additions/",
    desc: "Expand your living space with seamless architectural additions tailored to your family.",
    badge: "Room Additions",
    icon: "fa-solid fa-house-chimney-medical",
    bg: "/assets/additions/hero.webp"
  },
  {
    title: "General Remodeling",
    slug: base + "/landing-general-remodeling/",
    desc: "Full-home transformations with coordinated design, permitting, and quality construction.",
    badge: "Full Home",
    icon: "fa-solid fa-hammer",
    bg: "/assets/general/hero.webp"
  }
];
---

<Layout title="The ABC Pro | Landing Pages Hub" description="Landing pages for Abraham Building & Consulting in Los Angeles." disableGTM={true}>
  <div style="min-height:100vh;background:#F6F4F1;display:flex;flex-direction:column">
    <!-- Header -->
    <header style="background:#271D3E;color:#fff;padding:40px 24px;text-align:center;border-bottom:3px solid #BDA478">
      <div style="max-width:900px;margin:0 auto;display:flex;flex-direction:column;align-items:center;gap:16px">
        <img src="/assets/logo-abc-pro.webp" alt="The ABC Pro" width="120" height="82" style="object-fit:contain" />
        <h1 style="margin:0;font-family:'Noto Serif',Georgia,serif;font-size:clamp(28px, 4vw, 42px);font-weight:400;color:#fff">
          The ABC Pro — Landing Pages DEV
        </h1>
      </div>
    </header>

    <!-- Cards Grid -->
    <div style="flex:1;max-width:1180px;width:100%;margin:0 auto;padding:56px 24px;box-sizing:border-box">
      <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(320px, 1fr));gap:28px">
        {landings.map((lp, idx) => (
          <div style="background:#fff;border:1px solid #DDDDDD;border-top:4px solid #7A3F96;display:flex;flex-direction:column;overflow:hidden;box-shadow:0 4px 16px rgba(0,0,0,0.06);transition:transform 200ms ease, box-shadow 200ms ease">
            <a href={lp.slug} target="_blank" rel="noopener noreferrer" style="text-decoration:none;display:block">
              <div style={`height:180px;background:#000 url(${lp.bg}) center / cover no-repeat;position:relative`}>
                <div style="position:absolute;inset:0;background:rgba(39,29,62,0.45);transition:background 200ms ease"></div>
                <span style="position:absolute;top:16px;left:16px;background:#7A3F96;color:#fff;font-size:11px;font-weight:700;letter-spacing:0.15em;text-transform:uppercase;padding:4px 10px">
                  0{idx + 1}
                </span>
                <span style="position:absolute;top:16px;right:16px;background:rgba(0,0,0,0.7);color:#FDBD2E;font-size:11px;font-weight:600;padding:4px 10px">
                  {lp.badge}
                </span>
              </div>
            </a>
            <div style="padding:28px 24px;display:flex;flex-direction:column;gap:12px;flex:1">
              <a href={lp.slug} target="_blank" rel="noopener noreferrer" style="text-decoration:none">
                <h2 style="margin:0;font-family:'Noto Serif',Georgia,serif;font-size:22px;line-height:28px;color:#271D3E;font-weight:500;transition:color 200ms ease">
                  {lp.title}
                </h2>
              </a>
              <p style="margin:0;font-size:14.5px;line-height:22px;color:#5D5D5D;flex:1">
                {lp.desc}
              </p>
              <div style="margin-top:16px;padding-top:16px;border-top:1px solid #EEEEEE;display:flex;flex-direction:column;gap:10px">
                <a 
                  href={lp.slug}
                  target="_blank"
                  rel="noopener noreferrer"
                  style="display:inline-flex;align-items:center;justify-content:center;gap:8px;height:46px;background:#7A3F96;color:#fff;font-weight:600;font-size:12px;letter-spacing:0.20em;text-transform:uppercase;text-decoration:none;transition:background-color 200ms ease"
                >
                  <span>View Landing</span>
                  <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true" style="font-size:12px"></i>
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Footer -->
    <footer style="background:#fff;border-top:1px solid #DDDDDD;padding:24px;text-align:center;font-size:13px;color:#777">
      Abraham Building & Consulting © 2026 | All rights reserved
    </footer>
  </div>
</Layout>
