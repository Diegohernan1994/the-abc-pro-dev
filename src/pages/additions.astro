---
import Layout from '../layouts/Layout.astro';
import ReviewLogoCarousel from '../components/ReviewLogoCarousel.astro';
import DesktopReviewLogos from '../components/DesktopReviewLogos.astro';
import TrustBar from '../components/TrustBar.jsx';
import CardCarousel from '../components/CardCarousel.jsx';
import ProcessTimeline from '../components/ProcessTimeline.jsx';
import GalleryGrid from '../components/GalleryGrid.jsx';
import TestimonialsCarousel from '../components/TestimonialsCarousel.jsx';

const trustItems = [
  { icon: 'fa-solid fa-shield-halved', text: 'CSLB License #1046696' },
  { icon: 'fa-solid fa-house-chimney', text: 'Family-Owned & Managed' },
  { icon: 'fa-solid fa-award', text: '20+ Years of Industry Experience' },
  { icon: 'fa-solid fa-cube', text: 'Free 3D Design Visualization' },
];

const benefitCards = [
  {
    icon: 'fa-solid fa-people-roof',
    title: 'Begin with the life you need room for',
    description: 'Whether you need space for a growing family, work, guests, or a better primary suite, start by defining what the new space must solve.'
  },
  {
    icon: 'fa-solid fa-cube',
    title: 'Make the direction easier to see',
    description: '3D visualization helps you evaluate the project direction before you commit to major construction decisions.'
  },
  {
    icon: 'fa-solid fa-clipboard-check',
    title: 'Ask the feasibility questions early',
    description: 'Zoning, documentation, permits, and inspection requirements can vary by property and scope. The earlier these questions are surfaced, the better your planning conversation becomes.'
  },
  {
    icon: 'fa-solid fa-route',
    title: 'Keep one clear project path',
    description: 'Move from an in-person conversation to a defined direction, material selection, construction, and final walkthrough.'
  }
];

const conversationCards = [
  {
    icon: 'fa-solid fa-house-chimney-user',
    title: 'Your reason for adding space',
    description: 'More privacy, a better layout, room for family, or a home that can serve you longer.'
  },
  {
    icon: 'fa-solid fa-location-dot',
    title: 'Your property location',
    description: 'The jurisdiction and address affect which planning questions may be relevant.'
  },
  {
    icon: 'fa-solid fa-pen-ruler',
    title: 'Your current starting point',
    description: 'You can come with an idea, inspiration images, existing plans, or simply a space problem to solve.'
  }
];

const processSteps = [
  {
    number: '01',
    title: 'Meet and Define the Need',
    text: 'We discuss the space you want to gain, your property, your priorities, and the information needed to move toward a project direction.',
    image: '/assets/additions/step-02.webp'
  },
  {
    number: '02',
    title: 'Visualize and Finalize the Direction',
    text: '3D visualization helps you see the approach more clearly. Plans and material selections are finalized before construction proceeds.',
    image: '/assets/additions/step-01.webp'
  },
  {
    number: '03',
    title: 'Build and Complete the Walkthrough',
    text: 'The project moves into construction from the approved plan, followed by a final walkthrough together.',
    image: '/assets/additions/step-03.webp'
  }
];

const galleryPhotos = [
  '/assets/additions/a01.jpeg?v=3',
  '/assets/additions/a02.jpeg?v=3',
  '/assets/additions/a03.jpeg?v=3',
  '/assets/additions/a04.jpeg?v=3',
  '/assets/additions/a05.jpeg?v=3',
  '/assets/additions/a06.jpeg?v=3',
  '/assets/additions/a07.jpeg?v=3',
  '/assets/additions/a08.jpeg?v=3'
];

const testimonialsData = [
  {
    author: 'Daniela R.',
    location: 'Koreatown, Los Angeles, CA',
    quote: 'Rani and the team do an amazing Job on our renovation. We had our kitchen totally redone along with our pantry and bathrooms. We highly recommend them for any of your home renovations!',
    quoteColor: '#7A3F96',
    closeQuoteColor: '#DDDDDD',
    sourceLogo: '/assets/google-logo.svg',
    sourceName: 'Google Reviews',
    sourceText: 'published Google My Business review'
  },
  {
    author: 'Jackie J.',
    location: '',
    quote: "David provided constant oversight and communicated about my project status on a regular basis. He always made sure I'm happy. His workers are top notch—each one of them took care of my home like it was their own.",
    quoteColor: '#BDA478',
    closeQuoteColor: '#7A3F96',
    sourceLogo: '/assets/yelp-logo.png',
    sourceName: 'Yelp',
    sourceText: 'published Yelp review'
  }
];
---

<Layout title="Home Additions in Los Angeles | The ABC Pro" description="Start with a free consultation to explore the space your family needs and a smarter way to make it part of your home. Free 3D visualization and CSLB #1046696." preloadImage="/assets/additions/hero.jpeg?v=2">
  
  <!-- STICKY TOP CALL BAR -->
  <div class="top-nav-bar" style="position:sticky;top:0;z-index:50;background:rgba(255,255,255,0.96);border-bottom:1px solid #B5BCC0;display:flex;align-items:center;gap:24px;padding:10px 40px;box-shadow:0 1px 4px -1px rgba(0,0,0,0.12);border-radius:0">
    <img src="/assets/logo-abc-pro.webp" alt="Abraham Building & Consulting" class="nav-logo" style="width:107px;height:73px;object-fit:contain;display:block;flex-shrink:0;border-radius:0" />
    <a href="tel:8184573390" class="nav-phone-text" style="margin-left:auto;font-family:'Noto Serif',Georgia,serif;font-size:21px;color:#7A3F96;text-decoration:none;white-space:nowrap">(818) 457-3390</a>
    <a href="tel:8184573390" class="nav-call-btn" style="display:inline-flex;align-items:center;justify-content:center;gap:11px;height:44px;padding:0 42px;background:#7A3F96;color:#fff;font-weight:600;font-size:13px;letter-spacing:0.300em;text-transform:uppercase;text-decoration:none;white-space:nowrap;flex-shrink:0;border-radius:0">
      <i class="fa-solid fa-phone" aria-hidden="true" style="font-size:13px"></i>
      <span>Call Now</span>
    </a>
  </div>

  <!-- HERO SECTION -->
  <section class="hero-section" style="position:relative;min-height:620px;display:flex;align-items:center;background:#271D3E">
    <!-- Desktop Background -->
    <div class="hero-desktop-bg" style="position:absolute;inset:0;background:#271D3E url(/assets/additions/hero.jpeg?v=2) center 75% / cover no-repeat"></div>
    <div class="hero-overlay" style="position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,0.78) 0%,rgba(0,0,0,0.55) 48%,rgba(0,0,0,0.22) 100%);pointer-events:none"></div>

    <div class="hero-container" style="position:relative;width:100%;max-width:1180px;margin:0 auto;padding:60px 40px">
      
      <!-- Mobile-Only Hero Image (Top) -->
      <div class="hero-mobile-image-wrap">
        <img src="/assets/additions/hero.jpeg?v=2" alt="Home Additions in Los Angeles" class="hero-mobile-img" width="1200" height="675" loading="eager" fetchpriority="high" decoding="async" />
      </div>

      <div class="hero-grid-inner">
        <!-- TEXT CONTENT -->
        <div class="hero-text-block" style="display:flex;flex-direction:column;gap:22px">
          <span style="font-weight:900;font-size:13px;letter-spacing:0.300em;text-transform:uppercase;color:#FDBD2E">Create Room for What's Next</span>
          <h1 style="margin:0;font-family:'Noto Serif',Georgia,serif;font-weight:400;font-size:clamp(34px,4.4vw,52px);line-height:1.1;color:#fff;text-wrap:pretty">Home Additions in Los Angeles</h1>
          <h2 class="hero-subheading-italic" style="margin:-8px 0 0;font-family:'Noto Serif',Georgia,serif;font-style:italic;font-weight:400;font-size:clamp(22px,2.4vw,29px);line-height:1.28;color:#FDBD2E;text-wrap:pretty">See Your New Space Before You Build It.</h2>
          <p class="hero-review-description" style="margin:0;font-size:18px;line-height:28px;color:rgba(255,255,255,0.92);max-width:540px;text-wrap:pretty">Start with a free consultation to explore the space your family needs and a smarter way to make it part of your home.</p>
          <ReviewLogoCarousel caption="Trusted for Home Additions" />
          <a href="tel:8184573390" class="btn-gold-cta" style="align-self:flex-start;display:inline-flex;align-items:center;justify-content:center;gap:12px;height:52px;padding:0 40px;background:#BDA478;color:#fff;font-weight:600;font-size:14px;letter-spacing:0.300em;text-transform:uppercase;text-decoration:none;margin-top:4px;transition:background-color 200ms cubic-bezier(.25,.1,.25,1)">
            <i class="fa-solid fa-phone" aria-hidden="true" style="font-size:15px"></i>
            <span>Call (818) 457-3390</span>
          </a>
          <DesktopReviewLogos caption="Trusted for Home Additions" />
        </div>

        <!-- LEAD FORM -->
        <form id="lead-form" class="hero-form-card" data-landing="additions" style="background:#fff;max-width:460px;width:100%;justify-self:end;box-sizing:border-box;padding:30px 30px 26px;display:flex;flex-direction:column;gap:11px;box-shadow:0 14px 40px rgba(0,0,0,0.34)">
          <h2 style="margin:0 0 4px;font-family:'Noto Serif',Georgia,serif;font-weight:400;font-size:25px;line-height:31px;color:#7A3F96">Get My Free Home Addition Consultation</h2>
          <div class="form-row-2col" style="display:grid;grid-template-columns:1fr 1fr;gap:11px;width:100%">
            <input required placeholder="First Name" aria-label="First Name" name="first_name" style="font-family:'Noto Serif',Georgia,serif;font-size:14px;color:#5D5D5D;background:#fff;border:1px solid #B5BCC0;padding:11px 13px;outline:none;width:100%;box-sizing:border-box" />
            <input required placeholder="Last Name" aria-label="Last Name" name="last_name" style="font-family:'Noto Serif',Georgia,serif;font-size:14px;color:#5D5D5D;background:#fff;border:1px solid #B5BCC0;padding:11px 13px;outline:none;width:100%;box-sizing:border-box" />
          </div>
          <input required placeholder="Phone Number" aria-label="Phone Number" type="tel" name="phone" style="font-family:'Noto Serif',Georgia,serif;font-size:14px;color:#5D5D5D;background:#fff;border:1px solid #B5BCC0;padding:11px 13px;outline:none;width:100%;box-sizing:border-box" />
          <input required placeholder="Email" aria-label="Email Address" type="email" name="email" style="font-family:'Noto Serif',Georgia,serif;font-size:14px;color:#5D5D5D;background:#fff;border:1px solid #B5BCC0;padding:11px 13px;outline:none;width:100%;box-sizing:border-box" />
          <input required placeholder="ZIP Code" aria-label="ZIP Code" name="zip" style="font-family:'Noto Serif',Georgia,serif;font-size:14px;color:#5D5D5D;background:#fff;border:1px solid #B5BCC0;padding:11px 13px;outline:none;width:100%;box-sizing:border-box" />
          <textarea rows="3" placeholder="What space do you want to add or improve?" aria-label="Project details" name="message" style="font-family:'Noto Serif',Georgia,serif;font-size:14px;color:#5D5D5D;background:#fff;border:1px solid #B5BCC0;padding:11px 13px;outline:none;width:100%;box-sizing:border-box;resize:vertical"></textarea>
          <button type="submit" class="btn-purple-submit" style="height:54px;background:#7A3F96;color:#fff;border:none;font-family:Lato,sans-serif;font-weight:600;font-size:clamp(10px, 2.4vw, 11.5px);letter-spacing:0.07em;text-transform:uppercase;cursor:pointer;width:100%;padding:0 10px;box-sizing:border-box;display:flex;align-items:center;justify-content:center;white-space:nowrap;transition:background-color 200ms cubic-bezier(.25,.1,.25,1)">
            <span style="display:inline-flex;align-items:center;justify-content:center;white-space:nowrap;gap:8px">Get My Free Home Addition Consultation <i class="fa-solid fa-arrow-right" aria-hidden="true" style="font-size:12px;flex-shrink:0;vertical-align:middle;display:inline-block"></i></span>
          </button>
          <span style="font-size:12px;line-height:17px;color:#777;text-align:center">No obligation. Let’s talk about your project.</span>
        </form>
      </div>
    </div>
  </section>

  <!-- TRUST BAR / GUARANTEES -->
  <TrustBar client:load items={trustItems} maxWidth="1320px" />

  <!-- RISK REDUCTION PANEL + BENEFIT CARDS -->
  <section style="max-width:1180px;margin:0 auto;padding:84px 40px" class="content-section-padded">
    <div style="position:relative;padding-top:100px;min-height:560px;box-sizing:border-box" class="risk-panel-wrapper">
      <div class="risk-panel-bg" style="position:absolute;top:0;left:0;right:0;height:560px;background:#000 url(/assets/additions/panel-bg.jpeg?v=2) center / cover no-repeat"></div>
      <div class="risk-panel-card" style="position:relative;max-width:520px;margin-left:70px;background:#fff;padding:44px 40px;box-sizing:border-box;box-shadow:0 14px 40px rgba(39,29,62,0.18)">
        <div style="display:flex;flex-direction:column;gap:16px">
          <h2 style="margin:0;font-family:'Noto Serif',Georgia,serif;font-weight:400;font-size:30px;line-height:38px;color:#5D5D5D;text-wrap:pretty">Adding Space Is Not Just a Construction Decision. It Is a Property Decision.</h2>
          <p style="margin:0;font-size:15px;line-height:24px;text-wrap:pretty">A home addition has more moving parts than an interior update. You are considering the way a new footprint or new level connects to the home you already own. That means your early decisions should account for the space you need, how the existing home works, the property location, and the approvals or documents the project may require.</p>
          <a href="#lead-form" class="link-addition-options" style="align-self:flex-start;display:inline-flex;align-items:center;gap:10px;height:34px;margin-top:4px;padding:0;background:transparent;color:#7A3F96;font-family:'Noto Serif',Georgia,serif;font-weight:400;font-size:17px;letter-spacing:0;text-transform:none;text-decoration:none;box-shadow:inset 0 -1px 0 #7A3F96;transition:all 200ms cubic-bezier(.25,.1,.25,1)">
            <span>Explore My Addition Options <i class="fa-solid fa-arrow-right" aria-hidden="true" style="font-size:13.5px;margin-left:8px;vertical-align:middle;display:inline-block"></i></span>
          </a>
        </div>
      </div>
    </div>

    <!-- 4 BENEFIT CARDS (Desktop 2-Col Grid matching Design Cloud / Mobile Infinite 2s Carousel) -->
    <div class="benefits-grid-desktop" style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 56px;margin-top:56px">
      {benefitCards.map((card) => (
        <div class="benefit-card-row" style="padding:24px 0;border-bottom:1px solid #DDDDDD;cursor:default">
          <div class="benefit-card-inner" style="display:flex;gap:20px;align-items:flex-start;transition:transform 200ms cubic-bezier(.25,.1,.25,1)">
            <span style="flex:0 0 auto;width:50px;height:50px;display:flex;align-items:center;justify-content:center;background:#F6F4F1;color:#7A3F96;font-size:20px">
              <i class={card.icon} aria-hidden="true"></i>
            </span>
            <span style="display:flex;flex-direction:column;gap:7px">
              <span style="font-family:'Noto Serif',Georgia,serif;font-size:21px;line-height:27px;color:#7A3F96">{card.title}</span>
              <span style="font-size:15px;line-height:24px;color:#5D5D5D">{card.description}</span>
            </span>
          </div>
        </div>
      ))}
    </div>
    <div class="benefits-grid-mobile">
      <CardCarousel client:load cards={benefitCards} desktopColumns={2} />
    </div>
  </section>

  <!-- CALLOUT SPLIT BANNER -->
  <section class="split-callout-section" style="width:100%;display:grid;grid-template-columns:minmax(0,1fr) minmax(min(100%,520px),auto) minmax(0,1fr);min-height:400px">
    <div style="min-height:200px;background:#000 url(/assets/additions/explore-1.jpeg?v=1) center / cover no-repeat"></div>
    <div style="min-width:0;background:#271D3E;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:26px;padding:64px 40px;box-sizing:border-box;text-align:center">
      <h2 style="margin:0;font-family:'Noto Serif',Georgia,serif;font-weight:400;font-size:27px;line-height:36px;color:#FDBD2E;text-wrap:pretty">Explore My Addition Options</h2>
      <a href="tel:8184573390" class="btn-rather-talk" style="display:inline-flex;align-items:center;justify-content:center;gap:13px;height:56px;padding:0 40px;background:transparent;box-shadow:inset 0 0 0 1px #BDA478;color:#fff;font-family:'Noto Serif',Georgia,serif;font-size:19px;line-height:26px;text-decoration:none;transition:background-color 200ms cubic-bezier(.25,.1,.25,1)">
        <span>Rather talk it through?</span>
        <span style="display:inline-flex;align-items:center;gap:10px;white-space:nowrap">
          <i class="fa-solid fa-phone" aria-hidden="true" style="font-size:15px;color:#BDA478"></i>(818) 457-3390
        </span>
      </a>
    </div>
    <div class="split-callout-bottom-img" style="min-height:200px;background:#000 url(/assets/additions/explore-2.jpeg?v=1) center / cover no-repeat"></div>
  </section>

  <!-- BLUEPRINT / FEASIBILITY SECTION -->
  <section style="max-width:1180px;margin:0 auto;padding:84px 40px" class="content-section-padded">
    <div class="blueprint-grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:56px;align-items:center">
      <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));grid-template-rows:200px 200px;gap:10px">
        <div style="grid-column:span 2;background:#000 url(/assets/additions/blueprint-main.jpeg?v=1) center / cover no-repeat"></div>
        <div style="background:#000 url(/assets/additions/thumbs/a05.jpeg?v=1) center / cover no-repeat"></div>
        <div style="background:#000 url(/assets/additions/thumbs/a06.jpeg?v=1) center / cover no-repeat"></div>
      </div>
      <div style="display:flex;flex-direction:column;gap:20px">
        <h2 style="margin:0;font-family:'Noto Serif',Georgia,serif;font-weight:400;font-size:34px;line-height:43px;color:#5D5D5D;text-wrap:pretty">You Do Not Need a Finished Blueprint to Start a Useful Conversation.</h2>
        <p style="margin:0;font-size:16px;line-height:26px;text-wrap:pretty">You may be at the point where your home feels one room short. Or you may already have inspiration, a rough sketch, or an idea of where the expansion could go. The goal of this first conversation is to understand the problem, the property, and the decisions that should be made before you invest further in the project.</p>
      </div>
    </div>

    <!-- THREE COLUMN CONVERSATION CARDS -->
    <div style="position:relative;margin-top:56px;padding:44px 44px 42px;background:#FBFAF8;box-shadow:inset 0 0 0 1px #DDDDDD;overflow:hidden" class="conversation-box">
      <span style="position:relative;display:block;text-align:center;font-family:'Noto Serif',Georgia,serif;font-size:27px;line-height:34px;color:#7A3F96;margin-bottom:34px">A productive first conversation starts with</span>
      <div class="conv-grid-desktop" style="position:relative;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0">
        {conversationCards.map((card, idx) => (
          <div style={`display:flex;flex-direction:column;gap:12px;padding:0 30px;${idx < conversationCards.length - 1 ? 'border-right:1px solid #DDDDDD;' : ''}`}>
            <span style="width:46px;height:46px;display:flex;align-items:center;justify-content:center;background:#fff;box-shadow:inset 0 0 0 1px #DDDDDD;color:#7A3F96;font-size:18px">
              <i class={card.icon} aria-hidden="true"></i>
            </span>
            <span style="font-family:'Noto Serif',Georgia,serif;font-size:19px;line-height:26px;color:#5D5D5D">{card.title}</span>
            <span style="font-size:15px;line-height:24px;color:#5D5D5D">{card.description}</span>
          </div>
        ))}
      </div>
      <div class="conv-grid-mobile">
        <CardCarousel client:load cards={conversationCards} desktopColumns={3} />
      </div>
    </div>

    <div style="display:flex;justify-content:center;margin-top:34px">
      <a href="#lead-form" class="btn-gold-cta" style="display:inline-flex;align-items:center;justify-content:center;gap:13px;height:54px;padding:0 48px;background:#BDA478;color:#fff;font-weight:600;font-size:14px;letter-spacing:0.300em;text-transform:uppercase;text-decoration:none;transition:background-color 200ms cubic-bezier(.25,.1,.25,1)">
        <span>Get Clarity on My Addition <i class="fa-solid fa-arrow-right" aria-hidden="true" style="font-size:13.5px;margin-left:8px;vertical-align:middle;display:inline-block"></i></span>
      </a>
    </div>
  </section>

  <!-- STEPS / PROCESS SECTION -->
  <section style="background:#F6F4F1;padding:84px 40px" class="content-section-padded">
    <div style="max-width:1080px;margin:0 auto">
      <h2 style="margin:0 0 52px;text-align:center;font-family:'Noto Serif',Georgia,serif;font-weight:400;font-size:36px;line-height:45px;color:#5D5D5D;text-wrap:pretty">A More Grounded Way to Start a Major Home Project.</h2>
      
      <!-- TIMELINE (Desktop Vertical / Mobile Horizontal Carousel) -->
      <ProcessTimeline client:load steps={processSteps} />

      <p style="margin:46px auto 0;max-width:840px;text-align:center;font-size:14px;line-height:23px;color:#777">The City of Los Angeles starts its homeowner project path with zoning and documentation, then permitting and inspections. Simpler projects and more complex projects can follow different review paths; a property-specific conversation is essential.</p>
    </div>
  </section>

  <!-- GALLERY SECTION -->
  <section style="width:100%;padding:84px 24px 24px;box-sizing:border-box" class="content-section-padded">
    <h2 style="margin:0 auto 16px;max-width:820px;text-align:center;font-family:'Noto Serif',Georgia,serif;font-weight:400;font-size:34px;line-height:43px;color:#5D5D5D;text-wrap:pretty">Additions We Have Built</h2>
    <p style="margin:0 auto 40px;max-width:640px;text-align:center;font-size:16px;line-height:25px">Completed addition projects across Los Angeles and the San Fernando Valley.</p>

    <GalleryGrid client:load photos={galleryPhotos}>
      <div style="display:flex;flex-direction:column;gap:8px">
        <div style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));grid-template-rows:repeat(2,minmax(0,1fr));gap:8px">
          <div style="position:relative;overflow:hidden;grid-row:span 2;min-height:620px">
            <img src="/assets/additions/thumbs/a01.jpeg?v=1" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block" />
          </div>
          <div style="position:relative;overflow:hidden">
            <img src="/assets/additions/thumbs/a02.jpeg?v=1" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block" />
          </div>
          <div style="position:relative;overflow:hidden;grid-row:span 2">
            <img src="/assets/additions/thumbs/a03.jpeg?v=1" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block" />
          </div>
          <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px">
            <div style="position:relative;overflow:hidden">
              <img src="/assets/additions/thumbs/a04.jpeg?v=1" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block" />
            </div>
            <div style="position:relative;overflow:hidden">
              <img src="/assets/additions/thumbs/a05.jpeg?v=1" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block" />
            </div>
          </div>
        </div>
        <div style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));grid-template-rows:360px;gap:8px">
          <div style="position:relative;overflow:hidden">
            <img src="/assets/additions/thumbs/a06.jpeg?v=1" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block" />
          </div>
          <div style="position:relative;overflow:hidden">
