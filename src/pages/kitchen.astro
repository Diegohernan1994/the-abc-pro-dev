---
import Layout from '../layouts/Layout.astro';
import ReviewLogoCarousel from '../components/ReviewLogoCarousel.astro';
import DesktopReviewLogos from '../components/DesktopReviewLogos.astro';
import TrustBar from '../components/TrustBar.jsx';
import CardCarousel from '../components/CardCarousel.jsx';
import ProcessTimeline from '../components/ProcessTimeline.jsx';
import GalleryGrid from '../components/GalleryGrid.jsx';
import TestimonialsCarousel from '../components/TestimonialsCarousel.jsx';
import BeforeAfterSlider from '../components/BeforeAfterSlider.jsx';

const trustItems = [
  { icon: 'fa-solid fa-shield-halved', text: 'CSLB License #1046696' },
  { icon: 'fa-solid fa-house-chimney', text: 'Family-Owned & Managed' },
  { icon: 'fa-solid fa-award', text: '20+ Years of Industry Experience' },
  { icon: 'fa-solid fa-cube', text: 'Free 3D Design Visualization' },
];

const benefitCards = [
  {
    icon: 'fa-solid fa-mug-hot',
    title: 'Start with your daily routine',
    description: 'Talk through where mornings bottleneck, where storage disappears, and how you want the room to work when everyone is home.'
  },
  {
    icon: 'fa-solid fa-cube',
    title: 'Visualize before you commit',
    description: '3D visualization gives you a clearer way to evaluate the design direction before construction begins.'
  },
  {
    icon: 'fa-solid fa-ruler-combined',
    title: 'Bring the scope into focus',
    description: 'Discuss the changes you are considering and the planning steps that may be needed for your property and project.'
  },
  {
    icon: 'fa-solid fa-route',
    title: 'Avoid the handoff maze',
    description: 'Begin with a team that follows one documented path from in-person meeting to final walkthrough.'
  }
];

const conversationCards = [
  {
    icon: 'fa-solid fa-comment-dots',
    title: 'Your daily frustrations',
    description: 'They reveal the functional problems your remodel needs to solve.'
  },
  {
    icon: 'fa-solid fa-star',
    title: 'Your must-haves',
    description: 'They keep the design conversation anchored in what matters most to you.'
  },
  {
    icon: 'fa-solid fa-location-dot',
    title: 'Your property address',
    description: 'Requirements can vary by scope and jurisdiction.'
  }
];

const processSteps = [
  {
    number: '01',
    title: 'Meet in Person',
    text: 'Tell us what is not working, what you want the room to feel like, and what priorities should guide the project.',
    image: '/assets/kitchen/k09.webp'
  },
  {
    number: '02',
    title: 'Design and Finalize',
    text: 'Use 3D visualization to explore the direction, then finalize plans and material selections before construction.',
    image: '/assets/kitchen/k07.webp'
  },
  {
    number: '03',
    title: 'Construct and Walk Through',
    text: 'Your project proceeds from the approved plan, followed by a final walkthrough when the work is complete.',
    image: '/assets/kitchen/k10.webp'
  }
];

const galleryPhotos = [
  '/assets/kitchen/thumbs/k01.jpeg?v=1',
  '/assets/kitchen/k02-remodel-hq.webp?v=2k',
  '/assets/kitchen/k03.webp?v=2k',
  '/assets/kitchen/k04.webp?v=2k',
  '/assets/kitchen/k05.webp?v=2k',
  '/assets/kitchen/thumbs/kitchen-gallery.jpeg?v=1',
  '/assets/kitchen/k06.webp?v=2k',
  '/assets/kitchen/k08.webp?v=2k',
  '/assets/kitchen/k09.webp?v=2k',
  '/assets/kitchen/k10.webp?v=2k'
];

const testimonialsData = [
  {
    author: 'Michael Minson',
    location: '',
    quote: "We hired Abraham Building & Consulting to remodel our old kitchen. We didn't know exactly what we wanted so they helped us with a design. The kitchen came out perfect as a design and I really like my new custom cabinets! Our project manager was very patient and always answered all questions. Everything was handled professionally.",
    quoteColor: '#7A3F96',
    closeQuoteColor: '#DDDDDD',
    sourceLogo: '/assets/google-logo.svg',
    sourceName: 'Google Reviews',
    sourceText: 'published Google My Business review'
  },
  {
    author: 'Celio B.',
    location: '',
    quote: "From the initial consultation through the design phase, to the finishing touches—Rani was on top of it! ... They brought ideas to the table that we hadn't considered for our kitchen remodel. We couldn’t be happier with the process and most importantly—the outcome.",
    quoteColor: '#BDA478',
    closeQuoteColor: '#7A3F96',
    sourceLogo: '/assets/google-logo.svg',
    sourceName: 'Google Reviews',
    sourceText: 'published Google My Business review'
  }
];
---

<Layout title="Luxury Kitchen Remodeling in Los Angeles | The ABC Pro" description="See the possibilities in 3D, then create a kitchen that feels as good to live in as it looks. Free consultation, CSLB #1046696." preloadImage="/assets/kitchen/hero.webp">
  
  <!-- STICKY TOP CALL BAR -->
  <div class="top-nav-bar" style="position:sticky;top:0;z-index:50;background:rgba(255,255,255,0.96);border-bottom:1px solid #B5BCC0;display:flex;align-items:center;gap:24px;padding:10px 40px;box-shadow:0 1px 4px -1px rgba(0,0,0,0.12);border-radius:0">
    <img src="/assets/logo-abc-pro.webp" alt="The ABC Pro" class="nav-logo" style="width:107px;height:73px;object-fit:contain;display:block;flex-shrink:0;border-radius:0" />
    <a href="tel:8184573390" class="nav-phone-text" style="margin-left:auto;font-family:'Noto Serif',Georgia,serif;font-size:21px;color:#7A3F96;text-decoration:none;white-space:nowrap">(818) 457-3390</a>
    <a href="tel:8184573390" class="nav-call-btn" style="display:inline-flex;align-items:center;justify-content:center;gap:11px;height:44px;padding:0 42px;background:#7A3F96;color:#fff;font-weight:600;font-size:13px;letter-spacing:0.300em;text-transform:uppercase;text-decoration:none;white-space:nowrap;flex-shrink:0;border-radius:0">
      <i class="fa-solid fa-phone" aria-hidden="true" style="font-size:13px"></i>
      <span>Call Now</span>
    </a>
  </div>

  <!-- HERO SECTION -->
  <section class="hero-section" style="position:relative;min-height:620px;display:flex;align-items:center;background:#271D3E">
    <!-- Desktop Background -->
    <div class="hero-desktop-bg" style="position:absolute;inset:0;background:#271D3E url(/assets/kitchen/hero.webp) center / cover no-repeat"></div>
    <div class="hero-overlay" style="position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,0.78) 0%,rgba(0,0,0,0.55) 48%,rgba(0,0,0,0.22) 100%);pointer-events:none"></div>

    <div class="hero-container" style="position:relative;width:100%;max-width:1180px;margin:0 auto;padding:60px 40px">
      
      <!-- Mobile-Only Hero Image (Top) -->
      <div class="hero-mobile-image-wrap">
        <img src="/assets/kitchen/hero.webp" alt="Luxury Kitchen Remodeling in Los Angeles" class="hero-mobile-img" width="1200" height="675" loading="eager" fetchpriority="high" decoding="async" />
      </div>

      <div class="hero-grid-inner">
        <!-- TEXT CONTENT -->
        <div class="hero-text-block" style="display:flex;flex-direction:column;gap:22px">
          <span style="font-weight:900;font-size:13px;letter-spacing:0.300em;text-transform:uppercase;color:#FDBD2E">Free Design Consultation</span>
          <h1 style="margin:0;font-family:'Noto Serif',Georgia,serif;font-weight:400;font-size:clamp(34px,4.6vw,54px);line-height:1.12;color:#fff;text-wrap:pretty">Luxury Kitchen Remodeling in Los Angeles</h1>
          <p class="hero-review-description" style="margin:0;font-size:18px;line-height:28px;color:rgba(255,255,255,0.92);max-width:540px;text-wrap:pretty">See the possibilities in 3D, then create a kitchen that feels as good to live in as it looks.</p>
          <ReviewLogoCarousel caption="Trusted for Kitchen Remodeling" />
          <a href="tel:8184573390" style="align-self:flex-start;display:inline-flex;align-items:center;justify-content:center;gap:12px;height:52px;padding:0 40px;background:#BDA478;color:#fff;font-weight:600;font-size:14px;letter-spacing:0.300em;text-transform:uppercase;text-decoration:none;margin-top:4px">
            <i class="fa-solid fa-phone" aria-hidden="true" style="font-size:15px"></i>
            <span>Call (818) 457-3390</span>
          </a>
          <DesktopReviewLogos caption="Trusted for Kitchen Remodeling" />
        </div>

        <!-- LEAD FORM -->
        <form id="lead-form" class="hero-form-card" data-landing="kitchen" style="background:#fff;max-width:460px;width:100%;justify-self:end;box-sizing:border-box;padding:30px 30px 26px;display:flex;flex-direction:column;gap:11px;box-shadow:0 14px 40px rgba(0,0,0,0.34)">
          <h2 style="margin:0 0 4px;font-family:'Noto Serif',Georgia,serif;font-weight:400;font-size:25px;line-height:31px;color:#7A3F96">Get My Free Kitchen Consultation</h2>
          <div class="form-row-2col" style="display:grid;grid-template-columns:1fr 1fr;gap:11px;width:100%">
            <input required placeholder="First Name" aria-label="First Name" name="first_name" style="font-family:'Noto Serif',Georgia,serif;font-size:14px;color:#5D5D5D;background:#fff;border:1px solid #B5BCC0;padding:11px 13px;outline:none;width:100%;box-sizing:border-box" />
            <input required placeholder="Last Name" aria-label="Last Name" name="last_name" style="font-family:'Noto Serif',Georgia,serif;font-size:14px;color:#5D5D5D;background:#fff;border:1px solid #B5BCC0;padding:11px 13px;outline:none;width:100%;box-sizing:border-box" />
          </div>
          <input required placeholder="Phone Number" aria-label="Phone Number" type="tel" name="phone" style="font-family:'Noto Serif',Georgia,serif;font-size:14px;color:#5D5D5D;background:#fff;border:1px solid #B5BCC0;padding:11px 13px;outline:none;width:100%;box-sizing:border-box" />
          <input required placeholder="Email" aria-label="Email Address" type="email" name="email" style="font-family:'Noto Serif',Georgia,serif;font-size:14px;color:#5D5D5D;background:#fff;border:1px solid #B5BCC0;padding:11px 13px;outline:none;width:100%;box-sizing:border-box" />
          <input required placeholder="ZIP Code" aria-label="ZIP Code" name="zip" style="font-family:'Noto Serif',Georgia,serif;font-size:14px;color:#5D5D5D;background:#fff;border:1px solid #B5BCC0;padding:11px 13px;outline:none;width:100%;box-sizing:border-box" />
          <textarea rows="3" placeholder="What is your biggest kitchen frustration today?" aria-label="Project details" name="message" style="font-family:'Noto Serif',Georgia,serif;font-size:14px;color:#5D5D5D;background:#fff;border:1px solid #B5BCC0;padding:11px 13px;outline:none;width:100%;box-sizing:border-box;resize:vertical"></textarea>
          <button type="submit" style="height:54px;background:#7A3F96;color:#fff;border:none;font-family:Lato,sans-serif;font-weight:600;font-size:clamp(11px, 2.6vw, 12.5px);letter-spacing:0.10em;text-transform:uppercase;cursor:pointer;width:100%;padding:0 12px;box-sizing:border-box;display:flex;align-items:center;justify-content:center;white-space:nowrap;transition:background-color 200ms cubic-bezier(.25,.1,.25,1)">
            <span style="display:inline-flex;align-items:center;justify-content:center;white-space:nowrap;gap:8px">Get My Free Kitchen Consultation <i class="fa-solid fa-arrow-right" aria-hidden="true" style="font-size:12.5px;flex-shrink:0;vertical-align:middle;display:inline-block"></i></span>
          </button>
          <span style="font-size:12px;line-height:17px;color:#777;text-align:center">No obligation. Let’s talk about your project.</span>
        </form>
      </div>
    </div>
  </section>

  <!-- TRUST BAR (Light Theme) -->
  <TrustBar client:load items={trustItems} theme="light" />

  <!-- SECTION 1: BETTER KITCHEN PANEL & BENEFIT CARDS -->
  <section class="content-section-padded" style="max-width:1180px;margin:0 auto;padding:84px 40px">
    <div class="risk-panel-wrapper" style="position:relative;padding-top:132px;min-height:490px;box-sizing:border-box">
      <div class="risk-panel-bg" style="position:absolute;top:0;left:0;right:0;height:490px;background:#000 url(/assets/kitchen/panel-bg.jpg?v=2) center / cover no-repeat"></div>
      <div class="risk-panel-card" style="position:relative;max-width:700px;margin-left:70px;background:#fff;padding:34px;box-sizing:border-box;box-shadow:0 14px 40px rgba(39,29,62,0.18)">
        <div style="display:flex;flex-direction:column;gap:16px">
          <h2 style="margin:0;font-family:'Noto Serif',Georgia,serif;font-weight:400;font-size:30px;line-height:38px;color:#5D5D5D;text-wrap:pretty">A Better Kitchen Is Not a Collection of Finishes. It Is a Better Way to Live at Home.</h2>
          <p style="margin:0;font-size:15px;line-height:24px;text-wrap:pretty">The difficult part of a kitchen project is not choosing a tile sample. It is making sure the layout, storage, appliances, lighting, materials, and construction scope serve the same plan. When those decisions are disconnected, homeowners can end up with a kitchen that photographs well but still feels frustrating to use.</p>
          <a href="#lead-form" style="align-self:flex-start;display:inline-flex;align-items:center;gap:10px;height:34px;margin-top:4px;padding:0;background:transparent;color:#7A3F96;font-family:'Noto Serif',Georgia,serif;font-weight:400;font-size:17px;letter-spacing:0;text-transform:none;text-decoration:none;box-shadow:inset 0 -1px 0 #7A3F96;transition:color 200ms cubic-bezier(.25,.1,.25,1)">
            <span>Talk Through My Kitchen Goals <i class="fa-solid fa-arrow-right" aria-hidden="true" style="font-size:13.5px;margin-left:8px;vertical-align:middle;display:inline-block"></i></span>
          </a>
        </div>
      </div>
    </div>

    <!-- BENEFIT CARDS (Desktop 2 cols / Mobile Carousel 2s auto-advance with square dots) -->
    <CardCarousel client:load cards={benefitCards} desktopColumns={2} />
  </section>

  <!-- MID-PAGE CTA BANNER 1 -->
  <section style="position:relative;width:100%;height:400px;display:grid;place-items:center;overflow:hidden">
    <div style="position:absolute;inset:0;background:#000 url(/assets/kitchen/band-1.jpg?v=2) center / cover no-repeat"></div>
    <div style="position:absolute;inset:0;background:rgba(0,0,0,0.58)"></div>
    <div style="position:relative;display:flex;flex-direction:column;align-items:center;gap:26px;padding:0 24px;text-align:center">
      <a href="#lead-form" style="display:inline-flex;align-items:center;justify-content:center;gap:13px;height:56px;padding:0 50px;background:#BDA478;color:#fff;font-weight:600;font-size:14px;letter-spacing:0.300em;text-transform:uppercase;text-decoration:none;transition:background-color 200ms cubic-bezier(.25,.1,.25,1)">
        <span>Talk Through My Kitchen Goals <i class="fa-solid fa-arrow-right" aria-hidden="true" style="font-size:13.5px;margin-left:8px;vertical-align:middle;display:inline-block"></i></span>
      </a>
      <div style="display:flex;align-items:center;justify-content:center;gap:16px;flex-wrap:wrap">
        <span style="font-family:'Noto Serif',Georgia,serif;font-size:21px;line-height:28px;color:#fff">Rather talk it through?</span>
        <a href="tel:8184573390" style="display:inline-flex;align-items:center;gap:10px;font-family:'Noto Serif',Georgia,serif;font-size:21px;line-height:28px;color:#fff;text-decoration:none">
          <i class="fa-solid fa-phone" aria-hidden="true" style="font-size:15px;color:#BDA478"></i>
          <span>(818) 457-3390</span>
        </a>
      </div>
    </div>
  </section>

  <!-- SECTION 2: RIGHT QUESTIONS + BRING THREE THINGS -->
  <section class="content-section-padded" style="max-width:1180px;margin:0 auto;padding:84px 40px">
    <div class="split-callout-section" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:56px;align-items:center">
      <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px">
        <div style="grid-column:span 2;aspect-ratio:16/9;overflow:hidden;background:#F6F4F1">
          <img src="/assets/kitchen/mosaic-top-kitchen.webp?v=2" alt="Luxury Kitchen Remodeling in Los Angeles" style="width:100%;height:100%;object-fit:cover;display:block" loading="lazy" decoding="async" />
        </div>
        <div style="aspect-ratio:3/2;overflow:hidden;background:#F6F4F1">
          <img src="/assets/kitchen/mosaic-island-kitchen.webp?v=2" alt="Custom Kitchen Island" style="width:100%;height:100%;object-fit:cover;display:block" loading="lazy" decoding="async" />
        </div>
        <div style="aspect-ratio:3/2;overflow:hidden;background:#F6F4F1">
          <img src="/assets/kitchen/mosaic-stove-kitchen.webp?v=2" alt="Kitchen Stove and Range Hood" style="width:100%;height:100%;object-fit:cover;display:block" loading="lazy" decoding="async" />
        </div>
      </div>
      <div style="display:flex;flex-direction:column;gap:20px">
        <h2 style="margin:0;font-family:'Noto Serif',Georgia,serif;font-weight:400;font-size:34px;line-height:43px;color:#5D5D5D;text-wrap:pretty">You Do Not Need Every Answer Before You Call. You Need the Right Questions.</h2>
        <p style="margin:0;font-size:16px;line-height:26px;text-wrap:pretty">Many kitchen projects begin with a feeling: “This room no longer works.” Your first step is to make that feeling specific. Is the problem traffic around the island? Storage? A closed-off layout? Poor light? A space that cannot comfortably host the people you care about? We help you turn those concerns into a project conversation with a clearer direction.</p>
      </div>
    </div>

    <!-- 3 THINGS BOX (Desktop 3 columns / Mobile Carousel 2s auto-advance with square dots) -->
    <div class="conversation-box" style="position:relative;margin-top:56px;padding:44px 44px 42px;background:#FBFAF8;box-shadow:inset 0 0 0 1px #DDDDDD;overflow:hidden">
      <span style="position:relative;display:block;text-align:center;font-family:'Noto Serif',Georgia,serif;font-size:27px;line-height:34px;color:#7A3F96;margin-bottom:34px">Bring these three things to the conversation</span>
      <CardCarousel client:load cards={conversationCards} desktopColumns={3} />
    </div>

    <div style="display:flex;justify-content:center;margin-top:34px">
      <a href="#lead-form" style="display:inline-flex;align-items:center;justify-content:center;gap:13px;height:54px;padding:0 48px;background:#BDA478;color:#fff;font-weight:600;font-size:14px;letter-spacing:0.300em;text-transform:uppercase;text-decoration:none;transition:background-color 200ms cubic-bezier(.25,.1,.25,1)">
        <span>Get Clarity on My Kitchen Plan <i class="fa-solid fa-arrow-right" aria-hidden="true" style="font-size:13.5px;margin-left:8px;vertical-align:middle;display:inline-block"></i></span>
      </a>
    </div>
  </section>

  <!-- INTERACTIVE BEFORE/AFTER SLIDER: 3D DESIGN VS REALITY -->
  <section class="content-section-padded comparison-section" style="width:100%;padding:84px 40px;box-sizing:border-box;background:#F6F4F1">
    <h2 style="margin:0 auto 34px;max-width:820px;text-align:center;font-family:'Noto Serif',Georgia,serif;font-weight:400;font-size:36px;line-height:45px;color:#5D5D5D;text-wrap:pretty">Turning Your Vision into Reality</h2>
    <div class="sliders-grid" style="max-width:1180px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,330px),1fr));gap:28px">
      <BeforeAfterSlider 
        client:load 
        beforeImg="/assets/kitchen/kitchen-1-3d.webp?v=4" 
        afterImg="/assets/kitchen/kitchen-1-after.webp?v=4" 
        beforeLabel="3D Design" 
        afterLabel="Reality" 
        aspectRatio="16 / 11" 
        labelBottom="Kitchen" 
      />
      <BeforeAfterSlider 
        client:load 
        beforeImg="/assets/kitchen/kitchen-2-render.webp?v=4" 
        afterImg="/assets/kitchen/kitchen-2-reality.webp?v=4" 
        beforeLabel="3D Design" 
        afterLabel="Reality" 
        aspectRatio="16 / 11" 
        labelBottom="Open Concept Modern Kitchen" 
      />
    </div>
    <p style="margin:26px auto 0;max-width:820px;text-align:center;font-size:16px;line-height:25px;color:#5D5D5D">Experience the journey from stunning 3D designs to breathtaking real-life transformations.</p>
  </section>

  <!-- SECTION 3: PROCESS TIMELINE -->
  <section style="background:#F6F4F1;padding:84px 40px" class="content-section-padded">
    <div style="max-width:1080px;margin:0 auto">
      <div style="width:100%;aspect-ratio:3924 / 1602;background:#F6F4F1 url(/assets/kitchen/sketch-transition.webp?v=2k) center / cover no-repeat;margin-bottom:48px"></div>
      <h2 style="margin:0 0 52px;text-align:center;font-family:'Noto Serif',Georgia,serif;font-weight:400;font-size:36px;line-height:45px;color:#5D5D5D;text-wrap:pretty">A More Deliberate Way to Move From Idea to Finished Kitchen.</h2>
      
      <!-- TIMELINE COMPONENT (Desktop left-rail vertical / Mobile 1-by-1 horizontal carousel with square dots) -->
      <ProcessTimeline client:load steps={processSteps} cardBg="white" />

      <p style="margin:46px auto 0;max-width:840px;text-align:center;font-size:14px;line-height:23px;color:#777">A kitchen remodel can involve a range of planning, permit, and inspection requirements depending on what is changing. We discuss the relevant next steps for your scope; city approval and scheduling are not guaranteed.</p>
    </div>
  </section>

  <!-- SECTION 4: GALLERY (KITCHENS WE HAVE BUILT) -->
  <section style="width:100%;padding:84px 24px 24px;box-sizing:border-box">
    <h2 style="margin:0 auto 16px;max-width:820px;text-align:center;font-family:'Noto Serif',Georgia,serif;font-weight:400;font-size:34px;line-height:43px;color:#5D5D5D;text-wrap:pretty">Kitchens We Have Built</h2>
    <p style="margin:0 auto 40px;max-width:640px;text-align:center;font-size:16px;line-height:25px">Completed kitchen projects across Los Angeles and the San Fernando Valley.</p>
    
    <!-- GALLERY COMPONENT (Desktop Mosaic Slot / Mobile 2-Column Grid) -->
    <GalleryGrid client:load photos={galleryPhotos}>
      <div style="display:flex;flex-direction:column;gap:8px">
        <div style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));grid-template-rows:repeat(2,minmax(0,1fr));gap:8px">
          <div style="background:#000 url(/assets/kitchen/thumbs/k01.jpeg?v=1) center / cover no-repeat;grid-row:span 2;min-height:430px"></div>
          <div style="overflow:hidden;background:#F6F4F1;position:relative;width:100%;height:100%">
            <img 
              src="/assets/kitchen/k02-remodel-hq.webp?v=2k" 
              alt="Custom Modern Kitchen Remodel with Island and Patio Access" 
              style="width:100%;height:100%;object-fit:cover;object-position:center 70%;display:block" 
              loading="lazy" 
              decoding="async" 
            />
          </div>
          <div style="background:#000 url(/assets/kitchen/k03.webp?v=2k) center / cover no-repeat;grid-row:span 2"></div>
          <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px">
            <div style="background:#000 url(/assets/kitchen/k04.webp?v=2k) center / cover no-repeat"></div>
            <div style="background:#000 url(/assets/kitchen/k05.webp?v=2k) center / cover no-repeat"></div>
          </div>
        </div>
        <div style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));grid-template-rows:repeat(2,minmax(0,1fr));gap:8px">
          <div style="background:#000 url(/assets/kitchen/thumbs/kitchen-gallery.jpeg?v=1) center / cover no-repeat;grid-row:span 2;min-height:430px"></div>
          <div style="background:#000 url(/assets/kitchen/k06.webp?v=2k) center / cover no-repeat"></div>
          <div style="background:#000 url(/assets/kitchen/k10.webp?v=2k) center / cover no-repeat;grid-row:span 2"></div>
          <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px">
