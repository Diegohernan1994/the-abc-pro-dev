---
import Layout from '../layouts/Layout.astro';
import ReviewLogoCarousel from '../components/ReviewLogoCarousel.astro';
import DesktopReviewLogos from '../components/DesktopReviewLogos.astro';
import TrustBar from '../components/TrustBar.jsx';
import CardCarousel from '../components/CardCarousel.jsx';
import ProcessTimeline from '../components/ProcessTimeline.jsx';
import GalleryGrid from '../components/GalleryGrid.jsx';
import TestimonialsCarousel from '../components/TestimonialsCarousel.jsx';
import BeforeAfterSlider from '../components/BeforeAfterSlider.jsx';

const trustItems = [
  { icon: 'fa-solid fa-shield-halved', text: 'CSLB License #1046696' },
  { icon: 'fa-solid fa-house-chimney', text: 'Family-Owned & Managed' },
  { icon: 'fa-solid fa-award', text: '20+ Years of Industry Experience' },
  { icon: 'fa-solid fa-cube', text: 'Free 3D Design Visualization' },
];

const benefitCards = [
  {
    icon: 'fa-solid fa-ruler-combined',
    title: 'Design for the way you move',
    description: 'Discuss shower access, vanity storage, lighting, and circulation before selecting finishes that may not solve the real problem.'
  },
  {
    icon: 'fa-solid fa-cube',
    title: 'See the direction before the disruption',
    description: 'Use 3D visualization to make key layout and style decisions easier to understand before construction begins.'
  },
  {
    icon: 'fa-solid fa-clipboard-check',
    title: 'Know what needs coordination',
    description: 'Your scope may involve permits and inspections. We discuss the requirements that apply to your property and project before you move ahead.'
  },
  {
    icon: 'fa-solid fa-handshake',
    title: 'Keep the process human',
    description: 'You get a team that starts with an in-person meeting, not a one-size-fits-all package.'
  }
];

const processSteps = [
  {
    number: '01',
    title: 'Meet in Person',
    text: 'We discuss your vision, needs, budget considerations, and the bathroom frustrations you want to solve.',
    image: '/assets/bath/n08.webp'
  },
  {
    number: '02',
    title: 'Visualize and Finalize',
    text: 'We develop the project direction with 3D visualization, then finalize plans and material selections before construction.',
    image: '/assets/bath/n10.webp'
  },
  {
    number: '03',
    title: 'Build and Walk Through',
    text: 'Construction moves forward with the project plan in place. At the end, we complete a final walkthrough together.',
    image: '/assets/bath/n03.webp'
  }
];

const galleryPhotos = [
  '/assets/bath/thumbs/n07.jpeg?v=2',
  '/assets/bath/thumbs/n12.jpeg?v=2',
  '/assets/bath/thumbs/n11.jpeg?v=1',
  '/assets/bath/thumbs/n09.jpeg?v=1',
  '/assets/bath/thumbs/n10.jpeg?v=1',
  '/assets/bath/n01.webp?v=3',
  '/assets/bath/thumbs/n06.jpeg?v=1',
  '/assets/bath/thumbs/n14.jpeg?v=2',
  '/assets/bath/thumbs/n04.jpeg?v=1',
  '/assets/bath/thumbs/n13.jpeg?v=1'
];

const testimonialsData = [
  {
    author: 'Paphawarin S.',
    location: 'Los Angeles, CA',
    quote: 'Amit from Abraham Building and Consulting did an excellent job with my bathroom. His price was fair with no hidden cost. Very honest guy. Everything was completed smoothly with minimal disruption.',
    quoteColor: '#7A3F96',
    closeQuoteColor: '#DDDDDD',
    sourceLogo: '/assets/yelp-logo.png',
    sourceName: 'Yelp',
    sourceText: 'published Yelp review'
  },
  {
    author: 'Jasmine B.',
    location: 'Inglewood, CA',
    quote: 'Rani was able to work with our budget, gave us the best plan and modern design for our bathroom renovation. Very impressive work.',
    quoteColor: '#DDDDDD',
    closeQuoteColor: '#7A3F96',
    sourceLogo: '/assets/yelp-logo.png',
    sourceName: 'Yelp',
    sourceText: 'published Yelp review'
  }
];
---

<Layout title="Bathroom Remodeling in Los Angeles, Made Simple | The ABC Pro" description="Get a clear plan for a bathroom that looks better, works better, and feels like your own, with Free 3D design before construction begins. CSLB #1046696." preloadImage="/assets/bath/hero2.webp">
  
  <!-- STICKY TOP CALL BAR -->
  <div class="top-nav-bar" style="position:sticky;top:0;z-index:50;background:rgba(255,255,255,0.96);border-bottom:1px solid #B5BCC0;display:flex;align-items:center;gap:24px;padding:10px 40px;box-shadow:0 1px 4px -1px rgba(0,0,0,0.12);border-radius:0">
    <img src="/assets/logo-abc-pro.webp" alt="The ABC Pro" class="nav-logo" style="width:110px;height:82px;object-fit:contain;display:block;flex-shrink:0;border-radius:0" />
    <a href="tel:8184573390" class="nav-phone-text" style="margin-left:auto;font-family:'Noto Serif',Georgia,serif;font-size:21px;color:#7A3F96;text-decoration:none;white-space:nowrap">(818) 457-3390</a>
    <a href="tel:8184573390" class="nav-call-btn" style="display:inline-flex;align-items:center;justify-content:center;gap:11px;height:44px;padding:0 42px;background:#7A3F96;color:#fff;font-weight:600;font-size:13px;letter-spacing:0.300em;text-transform:uppercase;text-decoration:none;white-space:nowrap;flex-shrink:0;border-radius:0">
      <i class="fa-solid fa-phone" aria-hidden="true" style="font-size:13px"></i>
      <span>Call Now</span>
    </a>
  </div>

  <!-- HERO SECTION -->
  <section class="hero-section" style="position:relative;min-height:660px;display:flex;align-items:center;background:#271D3E">
    <!-- Desktop Background -->
    <div class="hero-desktop-bg" style="position:absolute;inset:0;background:#000 url(/assets/bath/hero2.webp) center / cover no-repeat"></div>
    <div class="hero-overlay" style="position:absolute;inset:0;background:linear-gradient(90deg,rgba(39,29,62,0.82) 0%,rgba(39,29,62,0.62) 46%,rgba(39,29,62,0.30) 100%);pointer-events:none"></div>

    <div class="hero-container" style="position:relative;width:100%;max-width:1180px;margin:0 auto;padding:64px 40px">
      
      <!-- Mobile-Only Hero Image (Top) -->
      <div class="hero-mobile-image-wrap">
        <img src="/assets/bath/hero2.webp" alt="Bathroom Remodeling in Los Angeles" class="hero-mobile-img" width="1200" height="675" loading="eager" fetchpriority="high" decoding="async" />
      </div>

      <div class="hero-grid-inner">
        <!-- TEXT CONTENT -->
        <div class="hero-text-block" style="display:flex;flex-direction:column;gap:22px">
          <span style="font-weight:900;font-size:13px;letter-spacing:0.300em;text-transform:uppercase;color:#FDBD2E">Free In-Home Consultation</span>
          <h1 class="hero-main-title" style="margin:0;font-family:'Noto Serif',Georgia,serif;font-weight:400;font-size:clamp(32px,4vw,48px);line-height:1.15;color:#fff">Bathroom Remodeling<br />in Los Angeles,<br />Made Simple</h1>
          <p class="hero-review-description" style="margin:0;font-size:18px;line-height:28px;color:rgba(255,255,255,0.92);max-width:580px;text-wrap:pretty">Get a clear plan for a bathroom that looks better, works better, and feels like your own, with Free 3D design before construction begins.</p>
          <ReviewLogoCarousel caption="Trusted for Bathroom Remodeling" />
          <div style="display:flex;align-items:center;gap:18px;flex-wrap:wrap;margin-top:6px">
            <a href="tel:8184573390" style="display:inline-flex;align-items:center;justify-content:center;gap:12px;height:52px;padding:0 40px;background:#BDA478;color:#fff;font-weight:600;font-size:14px;letter-spacing:0.300em;text-transform:uppercase;text-decoration:none">
              <i class="fa-solid fa-phone" aria-hidden="true" style="font-size:15px"></i>
              <span>Call (818) 457-3390</span>
            </a>
          </div>
          <DesktopReviewLogos caption="Trusted for Bathroom Remodeling" />
        </div>

        <!-- LEAD FORM -->
        <form id="lead-form" class="hero-form-card" data-landing="bathroom" style="background:#fff;max-width:460px;width:100%;justify-self:end;box-sizing:border-box;padding:30px 30px 26px;display:flex;flex-direction:column;gap:11px;box-shadow:0 14px 40px rgba(0,0,0,0.30)">
          <h2 style="margin:0 0 4px;font-family:'Noto Serif',Georgia,serif;font-weight:400;font-size:25px;line-height:31px;color:#7A3F96">Get My Free Bathroom Consultation</h2>
          <div class="form-row-2col" style="display:grid;grid-template-columns:1fr 1fr;gap:11px;width:100%">
            <input required placeholder="First Name" aria-label="First Name" name="first_name" style="font-family:'Noto Serif',Georgia,serif;font-size:14px;color:#5D5D5D;background:#fff;border:1px solid #B5BCC0;padding:11px 13px;outline:none;width:100%;box-sizing:border-box" />
            <input required placeholder="Last Name" aria-label="Last Name" name="last_name" style="font-family:'Noto Serif',Georgia,serif;font-size:14px;color:#5D5D5D;background:#fff;border:1px solid #B5BCC0;padding:11px 13px;outline:none;width:100%;box-sizing:border-box" />
          </div>
          <input required placeholder="Phone Number" aria-label="Phone Number" type="tel" name="phone" style="font-family:'Noto Serif',Georgia,serif;font-size:14px;color:#5D5D5D;background:#fff;border:1px solid #B5BCC0;padding:11px 13px;outline:none;width:100%;box-sizing:border-box" />
          <input required placeholder="Email" aria-label="Email Address" type="email" name="email" style="font-family:'Noto Serif',Georgia,serif;font-size:14px;color:#5D5D5D;background:#fff;border:1px solid #B5BCC0;padding:11px 13px;outline:none;width:100%;box-sizing:border-box" />
          <input required placeholder="ZIP Code" aria-label="ZIP Code" name="zip" style="font-family:'Noto Serif',Georgia,serif;font-size:14px;color:#5D5D5D;background:#fff;border:1px solid #B5BCC0;padding:11px 13px;outline:none;width:100%;box-sizing:border-box" />
          <textarea rows="3" placeholder="What would make your bathroom work better?" aria-label="Project details" name="message" style="font-family:'Noto Serif',Georgia,serif;font-size:14px;color:#5D5D5D;background:#fff;border:1px solid #B5BCC0;padding:11px 13px;outline:none;width:100%;box-sizing:border-box;resize:vertical"></textarea>
          <button type="submit" style="height:54px;background:#BDA478;color:#fff;border:none;font-family:Lato,sans-serif;font-weight:600;font-size:clamp(11px, 2.6vw, 12.5px);letter-spacing:0.10em;text-transform:uppercase;cursor:pointer;width:100%;padding:0 12px;box-sizing:border-box;display:flex;align-items:center;justify-content:center;white-space:nowrap;transition:background-color 200ms cubic-bezier(.25,.1,.25,1)">
            <span style="display:inline-flex;align-items:center;justify-content:center;white-space:nowrap;gap:8px">Get My Free Bathroom Consultation <i class="fa-solid fa-arrow-right" aria-hidden="true" style="font-size:12.5px;flex-shrink:0;vertical-align:middle;display:inline-block"></i></span>
          </button>
          <span style="font-size:12px;line-height:17px;color:#777;text-align:center">No obligation. Let’s talk about your project.</span>
        </form>
      </div>
    </div>
  </section>

  <!-- TRUST BAR (Dark Theme) -->
  <!-- Desktop Trust Bar (> 1200px) -->
  <div class="bath-trustbar-desktop" style="background:#271D3E;padding:26px 40px">
    <div style="max-width:1180px;margin:0 auto;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:24px">
      <div style="display:flex;flex-direction:column;align-items:center;gap:10px;text-align:center">
        <i class="fa-solid fa-shield-halved" aria-hidden="true" style="font-size:22px;color:#BDA478"></i>
        <span style="font-weight:600;font-size:12px;line-height:17px;letter-spacing:0.160em;text-transform:uppercase;color:rgba(255,255,255,0.95)">CSLB License #1046696</span>
      </div>
      <div style="display:flex;flex-direction:column;align-items:center;gap:10px;text-align:center">
        <i class="fa-solid fa-house-chimney" aria-hidden="true" style="font-size:22px;color:#BDA478"></i>
        <span style="font-weight:600;font-size:12px;line-height:17px;letter-spacing:0.160em;text-transform:uppercase;color:rgba(255,255,255,0.95)">Family-Owned &amp; Managed</span>
      </div>
      <div style="display:flex;flex-direction:column;align-items:center;gap:10px;text-align:center">
        <i class="fa-solid fa-award" aria-hidden="true" style="font-size:22px;color:#BDA478"></i>
        <span style="font-weight:600;font-size:12px;line-height:17px;letter-spacing:0.160em;text-transform:uppercase;color:rgba(255,255,255,0.95)">20+ Years of Industry Experience</span>
      </div>
      <div style="display:flex;flex-direction:column;align-items:center;gap:10px;text-align:center">
        <i class="fa-solid fa-cube" aria-hidden="true" style="font-size:22px;color:#BDA478"></i>
        <span style="font-weight:600;font-size:12px;line-height:17px;letter-spacing:0.160em;text-transform:uppercase;color:rgba(255,255,255,0.95)">Free 3D Design Visualization</span>
      </div>
    </div>
  </div>
  <!-- Mobile Trust Bar (<= 1200px) -->
  <div class="bath-trustbar-mobile">
    <TrustBar client:load items={trustItems} theme="dark" />
  </div>

  <!-- SECTION: A Bathroom Remodel Is Small in Square Footage... -->
  <section style="max-width:1180px;margin:0 auto;padding:84px 40px 0" class="content-section-padded">
    <div class="bath-overview-grid" style="display:grid;grid-template-columns:minmax(0,1.08fr) minmax(0,0.92fr);gap:56px;align-items:center">
      <div style="display:flex;flex-direction:column;gap:22px">
        <h2 style="margin:0;text-align:left;font-family:'Noto Serif',Georgia,serif;font-weight:400;font-size:36px;line-height:45px;color:#5D5D5D;text-wrap:pretty">A Bathroom Remodel Is Small in Square Footage. It Is Not Small in Decisions.</h2>
        <p style="margin:0;text-align:left;font-size:16px;line-height:25px;text-wrap:pretty">A bathroom is one of the most technical rooms in your home. Layout changes, plumbing, electrical, ventilation, finishes, and the condition behind existing walls can all affect the final scope. The right first conversation is not a rushed “What is your budget?” call. It is a clear look at how you use the space, what you want to change, and what the project may require.</p>
      </div>
      <div style="aspect-ratio:4 / 3;background:#271D3E url(/assets/bath/thumbs/n08.jpeg?v=1) center / cover no-repeat"></div>
    </div>

    <!-- 4 BENEFIT CARDS -->
    <!-- Desktop Grid (> 1200px): Exact 4-Column Box Cards with Hover from Design Cloud -->
    <div class="bath-cards-desktop" style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px;margin-top:52px;align-items:stretch">
      <div class="bath-benefit-card" style="display:flex;flex-direction:column;align-items:flex-start;gap:20px;padding:34px 28px 32px;background:#fff;box-shadow:inset 0 0 0 1px #DDDDDD;border-top:3px solid #DDDDDD;transition:box-shadow 200ms cubic-bezier(.25,.1,.25,1),border-color 200ms cubic-bezier(.25,.1,.25,1),transform 200ms cubic-bezier(.25,.1,.25,1)">
        <span style="width:58px;height:58px;flex:0 0 auto;display:flex;align-items:center;justify-content:center;background:#F6F4F1;color:#7A3F96;font-size:23px">
          <i class="fa-solid fa-ruler-combined" aria-hidden="true"></i>
        </span>
        <span style="font-family:'Noto Serif',Georgia,serif;font-size:21px;line-height:28px;color:#7A3F96;text-wrap:pretty">Design for the way you move</span>
        <span style="width:34px;height:2px;background:#BDA478"></span>
        <p style="margin:0;font-size:15px;line-height:24px;text-wrap:pretty;color:#5D5D5D">Discuss shower access, vanity storage, lighting, and circulation before selecting finishes that may not solve the real problem.</p>
      </div>

      <div class="bath-benefit-card" style="display:flex;flex-direction:column;align-items:flex-start;gap:20px;padding:34px 28px 32px;background:#fff;box-shadow:inset 0 0 0 1px #DDDDDD;border-top:3px solid #DDDDDD;transition:box-shadow 200ms cubic-bezier(.25,.1,.25,1),border-color 200ms cubic-bezier(.25,.1,.25,1),transform 200ms cubic-bezier(.25,.1,.25,1)">
        <span style="width:58px;height:58px;flex:0 0 auto;display:flex;align-items:center;justify-content:center;background:#F6F4F1;color:#7A3F96;font-size:23px">
          <i class="fa-solid fa-cube" aria-hidden="true"></i>
        </span>
        <span style="font-family:'Noto Serif',Georgia,serif;font-size:21px;line-height:28px;color:#7A3F96;text-wrap:pretty">See the direction before the disruption</span>
        <span style="width:34px;height:2px;background:#BDA478"></span>
        <p style="margin:0;font-size:15px;line-height:24px;text-wrap:pretty;color:#5D5D5D">Use 3D visualization to make key layout and style decisions easier to understand before construction begins.</p>
      </div>

      <div class="bath-benefit-card" style="display:flex;flex-direction:column;align-items:flex-start;gap:20px;padding:34px 28px 32px;background:#fff;box-shadow:inset 0 0 0 1px #DDDDDD;border-top:3px solid #DDDDDD;transition:box-shadow 200ms cubic-bezier(.25,.1,.25,1),border-color 200ms cubic-bezier(.25,.1,.25,1),transform 200ms cubic-bezier(.25,.1,.25,1)">
        <span style="width:58px;height:58px;flex:0 0 auto;display:flex;align-items:center;justify-content:center;background:#F6F4F1;color:#7A3F96;font-size:23px">
          <i class="fa-solid fa-clipboard-check" aria-hidden="true"></i>
        </span>
        <span style="font-family:'Noto Serif',Georgia,serif;font-size:21px;line-height:28px;color:#7A3F96;text-wrap:pretty">Know what needs coordination</span>
        <span style="width:34px;height:2px;background:#BDA478"></span>
        <p style="margin:0;font-size:15px;line-height:24px;text-wrap:pretty;color:#5D5D5D">Your scope may involve permits and inspections. We discuss the requirements that apply to your property and project before you move ahead.</p>
      </div>

      <div class="bath-benefit-card" style="display:flex;flex-direction:column;align-items:flex-start;gap:20px;padding:34px 28px 32px;background:#fff;box-shadow:inset 0 0 0 1px #DDDDDD;border-top:3px solid #DDDDDD;transition:box-shadow 200ms cubic-bezier(.25,.1,.25,1),border-color 200ms cubic-bezier(.25,.1,.25,1),transform 200ms cubic-bezier(.25,.1,.25,1)">
        <span style="width:58px;height:58px;flex:0 0 auto;display:flex;align-items:center;justify-content:center;background:#F6F4F1;color:#7A3F96;font-size:23px">
          <i class="fa-solid fa-handshake" aria-hidden="true"></i>
        </span>
        <span style="font-family:'Noto Serif',Georgia,serif;font-size:21px;line-height:28px;color:#7A3F96;text-wrap:pretty">Keep the process human</span>
        <span style="width:34px;height:2px;background:#BDA478"></span>
        <p style="margin:0;font-size:15px;line-height:24px;text-wrap:pretty;color:#5D5D5D">You get a team that starts with an in-person meeting, not a one-size-fits-all package.</p>
      </div>
    </div>
    <!-- Mobile Carousel (<= 1200px) -->
    <div class="bath-cards-mobile">
      <CardCarousel client:load cards={benefitCards} desktopColumns={4} />
    </div>
  </section>

  <!-- BANNER CTA -->
  <section style="position:relative;width:100%;height:380px;display:grid;place-items:center;overflow:hidden;margin-top:84px">
    <div style="position:absolute;inset:0;background:#000 url(/assets/bath/n15.jpeg?v=2) center / cover no-repeat"></div>
    <div style="position:absolute;inset:0;background:rgba(0,0,0,0.58)"></div>
    <a href="#lead-form" style="position:relative;display:inline-flex;align-items:center;justify-content:center;gap:13px;height:56px;padding:0 50px;background:#7A3F96;color:#fff;font-weight:600;font-size:14px;letter-spacing:0.300em;text-transform:uppercase;text-decoration:none">
      <span>Discuss My Bathroom Project <i class="fa-solid fa-arrow-right" aria-hidden="true" style="font-size:13.5px;margin-left:8px;vertical-align:middle;display:inline-block"></i></span>
    </a>
  </section>

  <!-- SECTION: Before You Commit to a Remodel... -->
  <section style="max-width:1180px;margin:0 auto;padding:84px 40px" class="content-section-padded">
    <div class="blueprint-grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:56px;align-items:center">
      <div class="bath-mosaic-grid" style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));grid-template-rows:250px 250px;gap:10px">
        <div style="grid-row:span 2"><div style="width:100%;height:100%;background:#271D3E url(/assets/bath/thumbs/n11.jpeg?v=1) center / cover no-repeat;"></div></div>
        <div><div style="width:100%;height:100%;background:#271D3E url(/assets/bath/thumbs/n09.jpeg?v=1) center / cover no-repeat;"></div></div>
        <div><div style="width:100%;height:100%;background:#271D3E url(/assets/bath/thumbs/n02.jpeg?v=1) center / cover no-repeat;"></div></div>
      </div>
      <div style="display:flex;flex-direction:column;gap:20px">
        <h2 style="margin:0;font-family:'Noto Serif',Georgia,serif;font-weight:400;font-size:34px;line-height:43px;color:#5D5D5D;text-wrap:pretty">Before You Commit to a Remodel, Get Clear on What Your Bathroom Needs to Do.</h2>
        <p style="margin:0;font-size:16px;line-height:25px;text-wrap:pretty">You may be dealing with an awkward layout, not enough storage, a dated shower, poor light, or a space that no longer feels comfortable. Your consultation is the place to connect those day-to-day frustrations to a practical project direction. You do not need every material selected before you reach out. You need a productive conversation that helps you decide what comes first.</p>
        <div style="background:#F6F4F1;border-left:3px solid #BDA478;padding:22px 24px;display:flex;flex-direction:column;gap:8px">
          <span style="font-family:'Noto Serif',Georgia,serif;font-size:19px;color:#7A3F96">What we will talk through</span>
          <p style="margin:0;font-size:15px;line-height:23px">Your goals for the room, the changes you want to make, your visual preferences, the property location, and the information needed to define a responsible next step.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- BANNER CTA -->
  <section style="position:relative;width:100%;height:250px;display:grid;place-items:center;overflow:hidden">
    <div style="position:absolute;inset:0;background:#000 url(/assets/bath/n06.webp) center / cover no-repeat"></div>
    <div style="position:absolute;inset:0;background:rgba(0,0,0,0.58)"></div>
    <a href="#lead-form" style="position:relative;display:inline-flex;align-items:center;justify-content:center;gap:13px;height:56px;padding:0 50px;background:#BDA478;color:#fff;font-weight:600;font-size:14px;letter-spacing:0.300em;text-transform:uppercase;text-decoration:none">
      <span>Get Clarity on My Bathroom <i class="fa-solid fa-arrow-right" aria-hidden="true" style="font-size:13.5px;margin-left:8px;vertical-align:middle;display:inline-block"></i></span>
    </a>
  </section>

  <!-- INTERACTIVE BEFORE/AFTER SLIDER: 3D DESIGN VS REALITY -->
  <section style="width:100%;padding:84px 40px;box-sizing:border-box;background:#F6F4F1" class="content-section-padded">
    <h2 style="margin:0 auto 34px;max-width:820px;text-align:center;font-family:'Noto Serif',Georgia,serif;font-weight:400;font-size:36px;line-height:45px;color:#5D5D5D;text-wrap:pretty">Turning Your Vision into Reality</h2>
    <div class="sliders-grid" style="max-width:1180px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,330px),1fr));gap:28px">
